{
    "name": "abstract_screening_classifier_v1.0",
    "strict": true,
    "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "software_engineering_field": {
                "type": "boolean"
            },
            "provides_dataset": {
                "type": "boolean"
            },
            "dataset_names": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "analysis_type": {
                "type": "string",
                "enum": [
                    "quantitative",
                    "qualitative",
                    "both"
                ]
            },
            "research_categories": {
                "type": "array",
                "maxItems": 3,
                "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string",
                            "enum": [
                                "testing_debugging",
                                "maintenance_evolution",
                                "vcs_collaboration",
                                "libraries_ecosystems",
                                "requirements",
                                "design_architecture",
                                "process_management",
                                "program_analysis",
                                "formal_verification",
                                "program_synthesis",
                                "languages_compilers",
                                "dsl_modeling",
                                "dev_environments",
                                "reuse",
                                "documentation",
                                "deployment_operation",
                                "embedded_systems_software",
                                "search_based_se",
                                "other_se"
                            ]
                        },
                        "score": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100
                        }
                    },
                    "required": [
                        "name",
                        "score"
                    ]
                }
            },
            "notes": {
                "type": "string"
            }
        },
        "required": [
            "software_engineering_field",
            "provides_dataset",
            "dataset_names",
            "analysis_type",
            "research_categories",
            "notes"
        ]
    }
}